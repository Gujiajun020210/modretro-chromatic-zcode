{
  "mcpServers": {
    "modretro-chromatic": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/scripts/start-codex-chromatic.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "GB_STUDIO_LOG_LEVEL": "info"
      },
      "enabled": true,
      "timeoutMs": 60000
    }
  }
}
